# Database URL
DATABASE_URL="postgres://<user>:<password>@<url>:<port>/<db_name>"

# --- Database connection pool settings for traditional servers ---
# These values are suitable for development and will be overridden by the logic
# in `lib/database/connection.ts` in a serverless environment.
# DB_POOL_SIZE=20
# DB_IDLE_TIMEOUT=300
# DB_MAX_LIFETIME=14400
# DB_CONNECT_TIMEOUT=4
# Optional override for non-Zeabur ingress. Defaults to x-forwarded-for.
# RATE_LIMIT_IP_HEADER=x-forwarded-for

# Application settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional token for a deployment-specific Bing Webmaster property.
# BING_SITE_VERIFICATION=""

# Optional privacy-friendly analytics. Configure all three values together and
# create a separate Umami website ID for every deployment.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://analytics.example.com/script.js"
# NEXT_PUBLIC_UMAMI_WEBSITE_ID="00000000-0000-4000-8000-000000000000"
# NEXT_PUBLIC_UMAMI_DOMAINS="yourdomain.com,www.yourdomain.com"

# Optional OAuth credentials. Uncomment both values for each provider you use.
# At least one complete provider is required when emailAuth is disabled.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# Better Auth Secret
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Required only when SITE_CONFIG.features.emailAuth is true.
RESEND_API_KEY="required"
RESEND_EMAIL_FROM="noreply@your-verified-domain.com"

# Required only when SITE_CONFIG.features.uploads is true.
# Cloudflare R2 Storage
R2_ENDPOINT="https://YOUR-ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="https://your-custom-domain.com"
# Used by the scheduled upload-intent cleanup endpoint.
UPLOAD_CLEANUP_SECRET="replace-with-at-least-32-random-characters"
# Optional byte quotas. Defaults: 1 GiB per rolling 24 hours, 5 GiB total.
# UPLOAD_DAILY_QUOTA_BYTES=1073741824
# UPLOAD_TOTAL_QUOTA_BYTES=5368709120
# Set both values only for a bounded v1-to-v2 rolling deployment.
# Remove both variables after the migration window.
# UPLOAD_LEGACY_COMPLETION_SINCE="2026-07-25T00:00:00.000Z"
# UPLOAD_LEGACY_COMPLETION_UNTIL="2026-07-26T00:00:00.000Z"

# Required only when SITE_CONFIG.features.ai is true.
# AI assistant (Vercel AI SDK, any OpenAI-compatible endpoint)
LLM_API_KEY="your-llm-api-key"
# Optional endpoint override. Defaults to the OpenAI API.
# LLM_BASE_URL="https://api.openai.com/v1"
# Optional model override. Defaults to gpt-5.6-luna.
# AI_DEFAULT_MODEL="gpt-5.6-luna"

# Required only when SITE_CONFIG.features.billing is true.
# Payments
# Configure matching test or live credentials, then run pnpm stripe:sync-products.
# test_mode / live_mode
STRIPE_ENVIRONMENT=test_mode
# Prefer a restricted key with only the permissions this app uses.
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_secret
# Extra hostnames allowed for checkout and portal redirects. Set this only when
# Stripe serves those pages from your own domain. Comma separated.
# NEXT_PUBLIC_BILLING_TRUSTED_HOSTS="pay.example.com,billing.example.com"

# E2E testing
# Required only by pnpm test:e2e. Use a dedicated local database.
# E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_e2e"
# E2E_BASE_URL="http://127.0.0.1:3100"
